rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos are public
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Credential verification documents are PRIVATE and accessible ONLY to the owner professional and admins
    match /verification_documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
